# =====================================================================
# Beacon & Harbor U.S. Visa Advisory Portal - Environment Configuration
# =====================================================================

# 1. Supabase Project Configuration (Obtain from your Supabase Dashboard -> Project Settings -> API)
# Required for Production Database (PostgreSQL) and Document Storage:
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Client-side Supabase credentials (prefixed with VITE_ for Vite frontend bundler):
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 2. JWT & Session Security
# A random secret string used to sign applicant and administrator session tokens:
JWT_SECRET="beacon-harbor-production-secret-key-change-this"

# 3. Application Hosting
# The live domain where the application is hosted on Vercel:
APP_URL="https://your-app-name.vercel.app"
NODE_ENV="production"
